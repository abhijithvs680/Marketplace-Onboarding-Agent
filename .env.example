# Where the Vizru platform (receiver-web behind haproxy) lives.
# Used by the Vite dev proxy only.
VIZRU_PLATFORM_URL=https://innov-dev.beta.injomo.com

# Leave EMPTY in dev: requests go to /workflow.trigger/... and the Vite proxy
# forwards them, so the self-signed cert and CORS never come up.
# For a deployed build, set this to the platform origin — and make sure that
# origin is in Trigger.php's $allowedOrigins, or the browser blocks the reply.
VITE_VIZRU_BASE_URL=

# The workflow this app drives. Entry block: genericpost, auth_required = "0".
VITE_VIZRU_WORKFLOW=marketplaceonboardagent6aca3281a3e51

# Client-side ceiling for one agent turn. The Agent Node allows 120 s per
# provider call and loops up to 100 tool round trips, so keep this generous.
VITE_VIZRU_TIMEOUT_MS=180000
