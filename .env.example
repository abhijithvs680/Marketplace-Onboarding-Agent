# Where the Vizru platform (receiver-web behind haproxy) lives.
# Used by the Vite dev proxy only.
VIZRU_PLATFORM_URL=https://innov-dev.beta.injomo.com

# Leave EMPTY in dev: requests go to /workflow.trigger/... and the Vite proxy
# forwards them, so the self-signed cert and CORS never come up.
# For a deployed build, set this to the platform origin — and make sure that
# origin is in Trigger.php's $allowedOrigins, or the browser blocks the reply.
VITE_VIZRU_BASE_URL=

# The agent this app drives. Entry block: genericpost, auth_required = "0".
VITE_VIZRU_WORKFLOW=marketplaceonboardagent6aca3281a3e51

# MarketPlaceOnboard_StartSession — opens the row in VendorOnboardingSessions
# and mints the reference shown on the review page. Entry block: genericpost,
# auth_required = "0", ending in a customoutput (json).
# Leave empty until the workflow exists: the app then runs without a reference
# instead of failing.
VITE_VIZRU_WORKFLOW_START=marketplaceonboardstartsession6acb1116386db

# MarketPlaceOnboard_GetApplication — the read model behind the stage rail, the
# "Your submission" panel and the review page. Same entry-block contract.
# Leave empty until the workflow exists: the panel then stays on "Needed",
# which is honest — the client has not been told otherwise.
VITE_VIZRU_WORKFLOW_GET=marketplaceonboardgetapplication6acb104b64b60

# Client-side ceiling for one agent turn. The Agent Node allows 120 s per
# provider call and loops up to 100 tool round trips, so keep this generous.
# The two read/write workflows above use a fixed 20 s instead.
VITE_VIZRU_TIMEOUT_MS=180000
VITE_VIZRU_WORKFLOW_MESSAGES=marketplaceonboardgetmessages6acb4aee8f79a
